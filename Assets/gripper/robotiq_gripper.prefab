--- !u!114 &7691708132389102903
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8063035925191947157}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<ros2_control name=\"RobotiqGripperHardwareInterface\" type=\"system\">\r\n 
    <!-- Plugins -->\r\n  <hardware>\r\n    <plugin>mock_components/GenericSystem</plugin>\r\n   
    <param name=\"mock_sensor_commands\">False</param>\r\n    <param name=\"state_following_offset\">0.0</param>\r\n 
    </hardware>\r\n  <!-- Joint interfaces -->\r\n  <!-- With Gazebo or Hardware,
    they handle mimic joints, so we only need this command interface activated -->\r\n 
    <joint name=\"finger_joint\">\r\n    <command_interface name=\"position\" />\r\n   
    <state_interface name=\"position\">\r\n      <param name=\"initial_value\">0.695</param>\r\n   
    </state_interface>\r\n    <state_interface name=\"velocity\" />\r\n  </joint>\r\n 
    <joint name=\"left_inner_knuckle_joint\">\r\n    <state_interface name=\"position\"
    />\r\n    <state_interface name=\"velocity\" />\r\n  </joint>\r\n  <joint name=\"left_inner_finger_joint\">\r\n   
    <state_interface name=\"position\" />\r\n    <state_interface name=\"velocity\"
    />\r\n  </joint>\r\n  <joint name=\"right_outer_knuckle_joint\">\r\n    <state_interface
    name=\"position\" />\r\n    <state_interface name=\"velocity\" />\r\n  </joint>\r\n 
    <joint name=\"right_inner_knuckle_joint\">\r\n    <state_interface name=\"position\"
    />\r\n    <state_interface name=\"velocity\" />\r\n  </joint>\r\n  <joint name=\"right_inner_finger_joint\">\r\n   
    <state_interface name=\"position\" />\r\n    <state_interface name=\"velocity\"
    />\r\n  </joint>\r\n  <gpio name=\"reactivate_gripper\">\r\n    <command_interface
    name=\"reactivate_gripper_cmd\" />\r\n    <command_interface name=\"reactivate_gripper_response\"
    />\r\n  </gpio>\r\n</ros2_control>"
